<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexora.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090A0E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_nexora_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexora</item>
    </style>
    <style name="Theme.Nexora" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#090A0E</item>
        <item name="android:navigationBarColor">#090A0E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
