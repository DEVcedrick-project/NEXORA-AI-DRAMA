{
  "rules": {
    ".read": false,
    ".write": false,
    "series": {
      ".read": true,
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "wallet": {
          ".write": false
        },
        "vipStatus": {
          ".write": false
        },
        "unlockedEpisodes": {
          ".write": false
        },
        "connectionCheck": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['lastVerifiedAt']) && newData.numChildren() === 1 && newData.child('lastVerifiedAt').isNumber()"
        }
      }
    }
  }
}
